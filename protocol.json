{
  "dataset": {
    "version": "beans:0.1.0"
  },
  "segmentation": {
    "hsv": {
      "lower": [20, 20, 20],
      "upper": [100, 255, 255]
    },
    "morphology": {
      "kernel_size": 11,
      "open_iterations": 2,
      "close_iterations": 2
    }
  },
  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "l2": 0.0001,
    "dropout": 0.2,
    "augmentation": {
      "horizontal_flip": true,
      "brightness_delta": 0.05
    }
  },
  "seeds": [1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029, 1030]
}
